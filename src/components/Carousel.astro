---
import "../styles/components/skills.css";
import { skills } from "../data/profile";
---

<ul class="skills-grid" aria-label="Tecnologías y nivel de conocimiento">
    {skills.map((skill, index) => (
        <li class="skill" style={`animation-delay: ${Math.min(index, 7) * 60}ms`}>
            <h3>{skill.name}</h3>
            {skill.image ? (
                <span class:list={["skill-icon", { "skill-icon-light": skill.lightBackground }]}>
                    <img src={`/${skill.image}`} alt="" width="100" height="100" loading="lazy" />
                </span>
            ) : <span class="skill-mark" aria-hidden="true">{skill.mark}</span>}
            <p class="skill-level">{skill.label}</p>
        </li>
    ))}
</ul>
