---
import "../styles/components/nav.css";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
    { href: "/", label: "Home" },
    { href: "/portafolio", label: "Portafolio" },
    { href: "/CV", label: "CV" },
];
---

<nav class="site-nav" aria-label="Navegación principal">
    <div class="nav-links">
        {links.map(({ href, label }) => {
            const exact = pathname === href;
            const active = exact || (href === "/portafolio" && pathname.startsWith("/proyecto/"));
            return <a href={href} class:list={[{ active }]} aria-current={exact ? "page" : active ? "location" : undefined}>{label}</a>;
        })}
    </div>
</nav>
