---
import "../styles/components/education.css";
import { education } from "../data/profile";
---

<div class="education-grid">
    {education.map((study, index) => (
        <article class:list={["education-card", { "current-study": study.current }]} style={`animation-delay: ${index * 100}ms`}>
            <div class="school-panel">
                <span class="study-category">{study.category}</span>
                <div class="school-logo"><img src={study.image} alt="" width="112" height="112" loading="lazy" /></div>
            </div>
            <div class="education-body">
                <p class="institution">{study.institution}</p>
                <h3>{study.degree}</h3>
                <div class="education-period"><span class="period-marker" aria-hidden="true"></span><span>{study.period}</span>{study.current && <span class="current-label">En curso</span>}</div>
            </div>
        </article>
    ))}
</div>
