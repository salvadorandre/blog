---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import "../styles/showcase.css";
import "../styles/pages/home.css";
import { profile } from "../data/profile";
---

<Layout title="André Salvador | Software Developer" description="Conoce a André Salvador, desarrollador de software y estudiante de Ingeniería en Sistemas. Explora sus proyectos y trayectoria.">
    <main class="showcase home motion-page">
        <section class="hero animate__animated animate__fadeInUp" aria-labelledby="hero-title">
            <div class="hero-copy">
                <p class="hello">Hola, qué bueno verte por aquí.</p>
                <h1 id="hero-title">Soy {profile.firstName}<br /><span class="accent-text">{profile.lastName}.</span></h1>
                <p class="role">{profile.role}</p>
                <p class="intro">{profile.introduction}</p>
                <div class="hero-actions">
                    <a class="primary-link" href="/portafolio">Ver mis proyectos <span aria-hidden="true">↗</span></a>
                    <a class="secondary-link" href="/CV">Más sobre mí <span aria-hidden="true">→</span></a>
                    <a class="contact-link" href="https://www.instagram.com/andrews._.sn/" target="_blank" rel="noopener noreferrer">Escríbeme <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <div class="portrait-wrap">
                <figure class="portrait-card">
                    <img src="/andre.jpg" alt={`Retrato de ${profile.name}`} width="480" height="560" fetchpriority="high" />
                    <figcaption class="portrait-caption"><strong>{profile.name}</strong><span>{profile.homeCaption}</span></figcaption>
                </figure>
            </div>
        </section>
        <section class="explore-grid animate__animated animate__fadeInUp animate__delay-1s" aria-label="Explora mi trabajo y formación">
            <a class="explore-card" href="/portafolio">
                <span class="eyebrow">Lo que construyo</span>
                <h2>Mis proyectos <span aria-hidden="true">↗</span></h2>
                <p>Lo que he hecho para practicar, probar herramientas y resolver mis propias dudas.</p>
            </a>
            <a class="explore-card" href="/CV">
                <span class="eyebrow">Mi recorrido</span>
                <h2>Lo que estoy aprendiendo <span aria-hidden="true">↗</span></h2>
                <p>Mis estudios y las tecnologías con las que he trabajado hasta ahora.</p>
            </a>
        </section>
    </main>
    <Footer />
</Layout>
