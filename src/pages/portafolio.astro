---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import "../styles/showcase.css";

const projects = await getCollection("projects");
---

<Layout title="Portafolio | André Salvador">
    <main class="showcase portfolio">
        <header class="portfolio-header">
            <p class="eyebrow">Portafolio de desarrollo</p>
            <h1>Proyectos y<br /><span class="accent-text">aplicaciones web.</span></h1>
        </header>
        <section class="projects-grid" aria-label="Proyectos">
            {projects.map(({ data, slug }, index) => (
                <article class="project-card">
                    <a class="project-image" href={`/proyecto/${slug}`} aria-label={`Ver proyecto ${data.title}`}>
                        <img src={`/${data.img}`} alt={`Vista previa de ${data.title}`} loading="lazy" width="720" height="450" />
                    </a>
                    <div class="project-body">
                        <span class="project-number">Proyecto {String(index + 1).padStart(2, "0")}</span>
                        <h2><a href={`/proyecto/${slug}`}>{data.title}</a></h2>
                        <p>{data.description}</p>
                        <ul class="tech-list" aria-label="Tecnologías">
                            {data.language.split(",").map((technology) => <li>{technology.trim()}</li>)}
                        </ul>
                        <div class="project-links">
                            <a href={`/proyecto/${slug}`}>Ver detalles <span aria-hidden="true">→</span></a>
                            {data.url !== "#" && <a href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir demo de ${data.title} en una nueva pestaña`}>Demo <span aria-hidden="true">↗</span></a>}
                        </div>
                    </div>
                </article>
            ))}
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .portfolio-header { display: grid; grid-template-columns: 1.15fr 1fr; column-gap: 3rem; align-items: end; padding: 3.5rem 0 2.5rem; }
    .portfolio-header > .eyebrow { grid-column: 1 / -1; }
    h1 { margin: 1rem 0 0; font-size: clamp(2.5rem, 4.6vw, 4rem); font-weight: 800; letter-spacing: -.055em; line-height: 1.08; }
    .portfolio-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
    .portfolio-intro p { max-width: 39rem; color: #aeb9ce; line-height: 1.8; }
    .project-count { flex-shrink: 0; color: #c4b5fd; font-size: .75rem; padding-bottom: .3rem; }
    .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .project-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid #ffffff1c; border-radius: .6rem; background: #111827; transition: transform .25s, border-color .25s, box-shadow .25s; }
    .project-card:hover { transform: translateY(-5px); border-color: #a855f780; box-shadow: 0 20px 45px #0004; }
    .project-image { display: flex; align-items: center; justify-content: center; min-width: 0; aspect-ratio: 16 / 9; padding: .75rem; background: #1b2331; border-bottom: 1px solid #ffffff12; }
    .project-image img { display: block; width: 100%; height: 100%; object-fit: contain; }
    .project-number { margin-bottom: .75rem; color: #94a3b8; font: .75rem monospace; }
    .project-body { display: flex; flex-direction: column; flex: 1; min-width: 0; padding: 1.25rem; }
    .tech-list { display: flex; flex-wrap: wrap; gap: .45rem; list-style: none; padding: 0; margin: 0 0 1rem; }
    .tech-list li { padding: .3rem .65rem; border: 1px solid #a855f72b; border-radius: 999px; background: #a855f710; color: #d8b4fe; font-size: .7rem; }
    h2 { font-size: 1.5rem; font-weight: 700; letter-spacing: -.025em; overflow-wrap: anywhere; }
    h2 a:hover { color: #d8b4fe; }
    .project-body > p { margin: .75rem 0 1.25rem; color: #aeb9ce; font-size: 1rem; line-height: 1.75; max-width: 48ch; }
    .project-links { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.1rem; border-top: 1px solid #ffffff12; font-size: .85rem; }
    .project-links a { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; padding: .3rem 0; font-weight: 600; }
    .project-links a:first-child { color: #d8b4fe; }
    .project-links a:hover { color: #93c5fd; }
    .portfolio-note { margin-top: 3rem; color: #94a3b8; font-size: .85rem; text-align: center; }
    @media (max-width: 800px) { .portfolio-header { grid-template-columns: 1fr; padding-top: 2.5rem; gap: 1.25rem; } h1 { margin: 0; } }
    @media (max-width: 640px) { .projects-grid { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .project-card:hover, .project-card:hover img { transform: none; } }
</style>
