---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import "../styles/showcase.css";
import "../styles/pages/not-found.css";
---

<Layout title="Página no encontrada | André Salvador" description="La página que buscas no está disponible. Regresa al inicio o explora el portafolio de André Salvador.">
    <main class="showcase not-found">
        <section class="not-found-content" aria-labelledby="not-found-title">
            <p class="eyebrow">Error 404</p>
            <h1 id="not-found-title">No encontramos<br /><span class="accent-text">esta página.</span></h1>
            <p>Puede que el enlace haya cambiado o que la dirección esté escrita de forma incorrecta.</p>
            <div class="not-found-actions">
                <a class="primary-link" href="/">Volver al inicio <span aria-hidden="true">→</span></a>
                <a class="secondary-link" href="/portafolio">Ver proyectos</a>
            </div>
        </section>
        <div class="not-found-mark" aria-hidden="true">404</div>
    </main>
    <Footer />
</Layout>
