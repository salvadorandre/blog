---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Carousel from "../components/Carousel.astro";
import InfoEstudios from "../components/InfoEstudios.astro";
import Certifications from "../components/Certifications.astro";
import "../styles/showcase.css";
import "../styles/pages/cv.css";
import { profile } from "../data/profile";

const company = profile.company;
export const prerender = true;
---

<Layout title="CV | André Salvador" description="Formación, experiencia como cofundador de Code qx, certificaciones de Platzi y tecnologías de André Salvador.">
    <main class="showcase cv motion-page">
        <header class="cv-header animate__animated animate__fadeInUp">
            <div>
                <p class="eyebrow">Mi recorrido</p>
                <h1>
                    Lo que aprendo.<br /><span class="accent-text"
                        >Lo que construyo.</span>
                </h1>
            </div>
        </header>

        <nav class="cv-toc" aria-label="Secciones del currículum">
            <a href="#experience-title">Emprendimiento</a>
            <a href="#education-title">Estudios</a>
            <a href="#certifications-title">Certificaciones</a>
            <a href="#skills-title">Tecnologías</a>
        </nav>

        <section class="cv-section animate__animated animate__fadeInUp" aria-labelledby="experience-title">
            <div class="section-heading">
                <p class="eyebrow">Emprendimiento</p><h2 id="experience-title">
                    Un proyecto compartido
                </h2>
            </div>
            <article class="company-card">
                <div class="company-logo">
                    {
                        company.logo ? (
                            <img
                                src={company.logo}
                                alt={`Logo de ${company.name}`}
                                width="200"
                                height="200"
                            />
                        ) : (
                            <div class="logo-placeholder">
                                <>
                                    <span>Code qx</span>
                                    <small>Espacio para el logo</small>
                                </>
                            </div>
                        )
                    }
                </div>
                <div class="company-copy">
                    <div class="company-heading">
                        <h3>{company.name}</h3><span class="company-date"
                            >Desde {company.founded}</span>
                    </div>
                    <p class="company-role">{company.role}</p>
                    {company.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>
            </article>
        </section>

        <section class="cv-section animate__animated animate__fadeInUp" aria-labelledby="education-title">
            <div class="section-heading">
                <p class="eyebrow">Formación</p><h2 id="education-title">
                    Mis estudios
                </h2>
            </div>
            <InfoEstudios />
        </section>

        <section class="cv-section animate__animated animate__fadeInUp" aria-labelledby="certifications-title">
            <div class="section-heading">
                <p class="eyebrow">Aprendizaje continuo</p>
                <h2 id="certifications-title">Certificaciones</h2>
            </div>
            <Certifications />
        </section>

        <section class="cv-section animate__animated animate__fadeInUp" aria-labelledby="skills-title">
            <div class="section-heading">
                <p class="eyebrow">Herramientas</p><h2 id="skills-title">
                    Tecnologías con las que trabajo
                </h2>
            </div>
            <Carousel />
        </section>
    </main>
    <Footer />
</Layout>
