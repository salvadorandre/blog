---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/showcase.css";
import "../../styles/pages/project-detail.css";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const { title, description, img, url, language } = project.data;
---

<Layout title={`${title} | André Salvador`}>
    <main class="showcase portfolio project-detail">
        <nav class="back-nav" aria-label="Volver al portafolio">
            <a href="/portafolio"><span aria-hidden="true">←</span> Todos los proyectos</a>
        </nav>
        <header class="project-header">
            <p class="eyebrow">Portafolio / Detalle del proyecto</p>
            <h1>{title}</h1>
        </header>
        <div class="project-layout">
            <figure class="project-preview">
                <div class="preview-image">
                    <img src={`/${img}`} alt={`Vista de la aplicación ${title}`} fetchpriority="high" />
                </div>
                <figcaption>
                    <span>Vista del proyecto</span>
                    <a href={`/${img}`} target="_blank" rel="noopener noreferrer" aria-label={`Ver imagen completa de ${title} en una nueva pestaña`}>Ampliar imagen <span aria-hidden="true">↗</span></a>
                </figcaption>
            </figure>
            <aside class="project-info" aria-label="Información del proyecto">
                <section aria-labelledby="about-project">
                    <h2 id="about-project">Sobre este proyecto</h2>
                    <p class="description">{description}</p>
                </section>
                <section class="technologies" aria-labelledby="project-technologies">
                    <h2 id="project-technologies">Tecnologías utilizadas</h2>
                    <ul>{language.split(",").map((technology) => <li>{technology.trim()}</li>)}</ul>
                </section>
                <div class="project-actions">
                    {url !== "#" ? (
                        <>
                            <a class="primary-link" href={url} target="_blank" rel="noopener noreferrer">Probar la demo <span aria-hidden="true">↗</span></a>
                            <p class="demo-note">Se abre en una nueva pestaña.</p>
                        </>
                    ) : <p class="demo-note">Este proyecto todavía no tiene una demo pública.</p>}
                </div>
            </aside>
        </div>
        <div class="project-bottom">
            <p>Más de lo que he construido</p>
            <a class="secondary-link" href="/portafolio">Seguir explorando <span aria-hidden="true">→</span></a>
        </div>
    </main>
    <Footer />
</Layout>
